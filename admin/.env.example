# Copy this file to `.env.local` and adjust the values for your environment.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put private API keys or secrets in frontend environment variables:
# everything in the bundle can be read by anyone who opens the app.

# Base URL of the future backend API (server/).
VITE_API_BASE_URL=http://localhost:5000/api

# `true` keeps the LocalStorage-backed mock services (demo mode).
# Set to `false` once the backend implements the endpoints listed in README.md.
VITE_USE_MOCK_API=true
